#!/usr/bin/env ruby
require "fileutils"
require "tmpdir"
require_relative "../.github/scripts/quality_reports"

Dir.chdir(File.expand_path("..", __dir__))
FileUtils.mkdir_p("tmp/quality")
# A fresh directory prevents stale results from satisfying this run's gates.
directory = Dir.mktmpdir("run-", File.expand_path("tmp/quality"))
environment = { "RAILS_ENV" => "test", "COVERAGE" => "1", "COVERAGE_ROOT" => directory, "CUCUMBER_PUBLISH_ENABLED" => "false" }
results = {}

commands = {
  "rspec" => [ "bundle", "exec", "rspec", "--format", "progress", "--format", "json", "--out", "#{directory}/rspec.json" ],
  "cucumber" => [ "bundle", "exec", "cucumber", "--no-profile", "--strict", "--publish-quiet", "--format", "progress",
    "--format", "json", "--out", "#{directory}/cucumber.json" ]
}

commands.each do |suite, command|
  results[suite] = system(environment.merge("COVERAGE_SUITE" => suite), *command)
  begin
    count = QualityReports.public_send(suite, "#{directory}/#{suite}.json")
    puts "#{suite}: #{count} executed examples/scenarios"
  rescue QualityReports::Invalid => error
    warn error.message
    results[suite] = false
  end
end

# Keep existing Minitest tests running, but do not substitute them for either
# of the two rubric-required suites or include them in combined coverage.
results["minitest"] = system(environment, "bin/rails", "test")
results["combined"] = system(environment, "bundle", "exec", "ruby", "test_support/merge_coverage.rb")

summary = results.map { |name, passed| "- #{name}: #{passed ? "PASS" : "FAIL"}" }.join("\n")
puts "\n#{summary}\nReports: #{directory}"
File.write(File.join(directory, "summary.txt"), summary + "\n")
if ENV["GITHUB_STEP_SUMMARY"]
  File.open(ENV.fetch("GITHUB_STEP_SUMMARY"), "a") { |file| file.puts("### Quality of Work\n\n#{summary}") }
end
exit(results.values.all? ? 0 : 1)
