#!/usr/bin/env bash
# Light test run for development: about 10 seconds.
# Skips RSpec examples tagged :docker or :slow, and skips coverage.
# CI still runs the full suite; run `JUDGE_INTEGRATION=1 bundle exec rspec` and
# `JUDGE_INTEGRATION=1 bundle exec cucumber --no-profile --strict` before merging.
set -euo pipefail
cd "$(dirname "$0")/.."
FAST=1 COVERAGE=0 exec bundle exec rspec --format progress "$@"
