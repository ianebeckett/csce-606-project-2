<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Codecoach" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Codecoach">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <%= link_to "code coach", root_path, class: "wordmark" %>
      <nav aria-label="Main navigation">
        <% if current_user %>
          <%= link_to "Roadmap & Practice", problems_path %>
          <%= link_to "My submissions", attempts_path %>
          <span class="account-label"><%= current_user.email %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "text-button" %>
        <% else %>
          <%= link_to "Sign in", new_session_path %>
          <%= link_to "Create account", new_registration_path %>
        <% end %>
      </nav>
    </header>
    <main id="main-content" class="page-shell" tabindex="-1">
      <% flash.each do |type, message| %><div class="notice <%= type %>" role="status"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <footer class="site-footer">Code Coach</footer>
  </body>
</html>
