<% content_for :title, "#{@problem.title} · Code Coach" %>
<%= link_to "← All problems", problems_path, class: "back-link" %>
<div class="workspace">
  <section class="description-panel" aria-labelledby="problem-title">
    <p class="eyebrow"><%= @problem.topic.name %></p>
    <h1 id="problem-title"><%= @problem.title %></h1>
    <div class="badges"><span class="badge easy"><%= @problem.difficulty %></span><span class="badge ruby">4 languages</span></div>
    <p class="problem-description"><%= @problem.description %></p>
    <%= render "problems/examples", problem: @problem %>
    <p class="small"><%= link_to "LeetCode", @problem.source_url, rel: "noreferrer" %></p>
  </section>
  <div class="work-column">
  <%= render "problems/coach", practice_session: @coaching_session, problem: @problem if @coaching_session %>
  <% if current_user.premium? && @problem.interview_ready? %>
  <p><%= link_to "Practice as an interview", problem_interview_path(@problem), class: "button" %></p>
  <% end %>
  <% unless current_user.premium? %>
  <p class="notice">Upgrade to Premium to use Socratic code coaching: explain your approach to a coach before you write code. <%= link_to "Upgrade my account", account_path %></p>
  <% end %>
  <% if @coaching_session&.coaching_locked? %>
  <section class="editor-panel locked-editor" aria-labelledby="editor-title">
    <div class="panel-title"><h2 id="editor-title">Your solution</h2></div>
    <p class="locked-note">The editor unlocks once <%= @coaching_session.coach_name %> agrees with your approach.</p>
  </section>
  <% else %>
  <%= render "problems/editor", problem: @problem, attempt: @attempt, language: @language %>
  <% end %>
  </div>
</div>
