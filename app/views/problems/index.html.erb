<% content_for :title, "Roadmap & Problems · Code Coach" %>

<div class="page-heading">
  <h1>Problems</h1>


  <%= link_to reviews_path, class: "upcoming-reviews-card" do %>
    <section aria-labelledby="upcoming-reviews-title">
      <div class="upcoming-reviews-header">
        <h2 id="upcoming-reviews-title">Upcoming Reviews</h2>
        <span>View All </span>
      </div>

      <% if @upcoming_reviews_preview.any? %>
        <% @upcoming_reviews_preview.each do |review| %>
          <div class="upcoming-review-item">
            <span><%= review.problem.title %></span>
            <span><%= review.next_review_date.strftime("%b %d, %Y") %></span>
          </div>
        <% end %>
      <% else %>
        <p>No upcoming reviews scheduled.</p>
      <% end %>
    </section>
  <% end %>


  <div class="stat-card">
    <strong>
      <%= roadmap.solved_ids.size %><span> / <%= roadmap.topics.sum { |topic| topic.problems.size } %></span>
    </strong>
    <span>problems accepted</span>
  </div>
</div>

<div class="catalog-layout">
  <aside class="topic-panel" aria-label="Problem topics">
    <h2>ROADMAP</h2>
    <p class="small">Master each prerequisite to unlock the next topics.</p>
    <%= link_to "All unlocked problems", problems_path, class: @topic.nil? ? "topic-link selected" : "topic-link" %>
    <% if roadmap.topics.empty? %><p>No topics are available yet.</p><% end %>
    <% roadmap.topics.each do |topic| %>
      <div class="roadmap-topic <%= "selected" if @topic == topic %>">
        <% if roadmap.unlocked?(topic) %>
          <%= link_to topic.name, problems_path(topic: topic.id), class: "topic-link" %>
        <% else %>
          <span class="topic-link"><%= topic.name %></span>
        <% end %>
        <span class="topic-status"><%= roadmap.state(topic) %></span>
        <% if topic.prerequisites.any? %>
          <p class="small muted">Requires: <%= topic.prerequisites.map(&:name).join(", ") %></p>
        <% end %>
      </div>
    <% end %>
  </aside>
  <section class="problem-panel" aria-labelledby="problem-list-title">
    <!-- Spaced Repetition: Reviews due for the logged-in student -->
    <section aria-labelledby="due-reviews-title">
      <div class="panel-title">
        <h2 id="due-reviews-title">Due Reviews</h2>
      </div>
      <% if @due_reviews.empty? %>
        <!-- Empty state for students without due reviews -->
        <p class="empty-state">
          No problems are due for review.
        </p>

      <% else %>
        <div class="due-review-list">
          <% @due_reviews.each do |review| %>
            <article class="due-review-card">
              <div class="due-review-info">
                <h3>
                  <%= link_to review.problem.title,
                              problem_path(review.problem) %>
                </h3>
                <p class="muted small">
                  Due: <%= review.next_review_date.strftime("%b %d, %Y") %>
                </p>
              </div>
              <%= link_to "Review Now",
                          problem_path(review.problem),
                          class: "due-review-action" %>
            </article>
          <% end %>
        </div>
        <% if @due_reviews_count > 0 %>
          <div class="due-reviews-view-all">
            <%= link_to "View All #{@due_reviews_count} Due Reviews",
                        due_reviews_path %>
          </div>
        <% end %>
      <% end %>
    </section>

    <div class="panel-title"><h2 id="problem-list-title"><%= @topic&.name || "Unlocked problems" %></h2><span class="badge ruby">Ruby · Python · Go · C++</span></div>
    <% if @problems.empty? %><p class="empty-state"><%= @topic ? "No problems are available in this topic yet." : "No unlocked problems are available yet." %></p><% end %>
    <% @problems.each_with_index do |problem, index| %>
      <article class="problem-row">
        <span class="problem-number"><%= (index + 1).to_s.rjust(ApplicationHelper::NUMBER_WIDTH, ApplicationHelper::NUMBER_PADDING) %></span>
        <div><p class="muted small"><%= problem.topic.name %></p><h3><%= link_to problem.title, problem_path(problem) %></h3></div>
        <span class="badge easy"><%= problem.difficulty %></span>
        <span class="problem-status"><%= roadmap.solved_ids.include?(problem.id) ? Attempt::ACCEPTED : "Not solved" %></span>
        <%= link_to "Practice →", problem_path(problem), class: "practice-link", aria: { label: "Practice #{problem.title}" } %>
      </article>
    <% end %>
  </section>
</div>
