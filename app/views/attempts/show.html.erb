<% content_for :title, "#{@attempt.judge_result} · Code Coach" %>
<%= link_to "← My submissions", attempts_path, class: "back-link" %>
<p class="eyebrow">SUBMISSION #<%= @attempt.id %></p><h1><%= @attempt.problem.title %></h1>
<div class="result-card" role="status">
  <h2><%= @attempt.judge_result %></h2>
  <% if @attempt.judge_result == Attempt::PENDING %>
    <% if @attempt.judging_started_at %>
      <p>Judging has started.</p>
    <% else %>
      <p><%= @queue_wait.fetch(:count) %> submissions ahead. Estimated wait before judging starts: about <%= @queue_wait.fetch(:seconds) %> seconds.</p>
    <% end %>
    <p>This is an estimate while the judge is running. Delays, restarts, or retries can take longer.</p>
    <p><%= link_to "Refresh result", attempt_path(@attempt) %></p>
  <% end %>
  <p class="case-count"><%= @attempt.passed_cases %> / <%= @attempt.total_cases %> test cases passed</p>
  <p class="muted">Language: <%= Attempt.language_version(@attempt.language) %> · <%= @attempt.created_at.strftime(ApplicationHelper::SUBMISSION_TIME_FORMAT) %></p>
  <% if @attempt.error_message.present? %><pre class="error-detail"><%= @attempt.error_message %></pre><% end %>
</div>
<h2>Submitted <%= Attempt.language_name(@attempt.language) %> code</h2><pre class="saved-code"><code><%= @attempt.code %></code></pre>
<% unless current_user.premium? %><p class="muted">AI code review is available to Premium members. <%= link_to "Upgrade my account", account_path %></p><% end %>
<div class="attempt-actions">
  <% if current_user.premium? && @attempt.code_review_message %>
    <%= link_to "View AI code review", attempt_code_review_path(@attempt), class: "button" %>
  <% elsif current_user.premium? && @attempt.code.present? %>
    <%= button_to "Get AI code review", attempt_code_review_path(@attempt), class: "button" %>
  <% end %>
  <%= link_to "Try this problem again", problem_path(@attempt.problem), class: "button" %>
</div>



<% practice = @attempt.practice_session %>

<% latest_attempt = practice.attempts.order(created_at: :desc, id: :desc).first %>
<% already_rated = practice.review_scheduled_at.present? &&
                   @attempt.created_at <= practice.review_scheduled_at %>
<% if @attempt.id == latest_attempt&.id &&
      [Attempt::ACCEPTED, Attempt::WRONG_ANSWER].include?(@attempt.judge_result) &&
      !already_rated %>



  <dialog id="practice-rating-modal" class="rating-modal"
          aria-labelledby="review-rating-title">
    <div class="rating-modal__content">
      <p class="eyebrow">PRACTICE COMPLETE</p>

      <h2 id="review-rating-title">How did that feel?</h2>

      <p class="rating-modal__description">
        How well did you understand this problem?
        Your rating helps us schedule your next review date.
      </p>

      <%= form_with url: rate_practice_session_path(practice),
                    method: :patch,
                    local: true,
                    class: "rating-form" do |form| %>
        <%= form.hidden_field :attempt_id, value: @attempt.id %>

        <fieldset class="rating-options">
          <legend class="sr-only">Your performance rating</legend>

          <% [
               [1, "Very difficult"],
               [2, "Difficult"],
               [3, "Moderate"],
               [4, "Easy"],
               [5, "Very easy"]
             ].each do |value, description| %>
            <div class="rating-option">
              <%= form.radio_button :review_rating, value,
                                    id: "review_rating_#{value}", required: true %>

              <%= form.label :review_rating,
                             for: "review_rating_#{value}",
                             class: "rating-choice" do %>
                <span class="rating-choice__number"><%= value %></span>
                <span class="rating-choice__label"><%= description %></span>
              <% end %>
            </div>
          <% end %>
        </fieldset>

        <%= form.submit "Complete Practice",
                        class: "button rating-submit" %>
      <% end %>
    </div>
  </dialog>
<% end %>
